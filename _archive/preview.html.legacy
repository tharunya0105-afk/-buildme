<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BuildMe - AI + Spatial Intelligence for Construction</title>
<style>
:root{--primary:#2563eb;--primary-dark:#1d4ed8;--border:#e5e7eb;--surface:#f9fafb;--text:#111827;--text2:#4b5563;--text3:#9ca3af;--green:#059669;--green-bg:#ecfdf5;--amber:#d97706;--amber-bg:#fffbeb;--red:#dc2626;--red-bg:#fef2f2;}
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:var(--text);background:#fff;min-height:100vh;}
.sidebar{position:fixed;left:0;top:0;width:256px;height:100vh;background:#fff;border-right:1px solid var(--border);z-index:40;display:flex;flex-direction:column;transition:transform .2s;}
.sidebar-header{display:flex;align-items:center;gap:8px;padding:16px 20px;border-bottom:1px solid var(--border);}
.sidebar-header h1{font-size:17px;font-weight:700;}
.sidebar-nav{flex:1;padding:12px 8px;overflow-y:auto;}
.nav-sec{margin-bottom:14px;}
.nav-sec-title{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--text3);padding:0 12px;margin-bottom:6px;}
.nav-item{display:flex;align-items:center;gap:10px;padding:7px 12px;border-radius:6px;font-size:13px;font-weight:500;color:var(--text2);cursor:pointer;transition:all .15s;text-decoration:none;border:none;background:none;width:100%;text-align:left;}
.nav-item:hover{background:var(--surface);color:var(--text);}
.nav-item.active{background:rgba(37,99,235,.1);color:var(--primary);}
.main{margin-left:256px;min-height:100vh;}
.page{display:none;padding:20px 28px;}
.page.active{display:block;}
.page-hdr{margin-bottom:20px;}
.page-hdr h2{font-size:22px;font-weight:700;}
.page-hdr p{font-size:13px;color:var(--text2);margin-top:2px;}
.card{background:#fff;border:1px solid var(--border);border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.05);}
.card-hdr{padding:14px 20px;border-bottom:1px solid var(--border);}
.card-body{padding:14px 20px;}
.grid{display:grid;gap:12px;}
.g2{grid-template-columns:repeat(2,1fr);}
.g3{grid-template-columns:repeat(3,1fr);}
.g4{grid-template-columns:repeat(4,1fr);}
.g5{grid-template-columns:repeat(5,1fr);}
@media(max-width:900px){.g2,.g3,.g4,.g5{grid-template-columns:repeat(2,1fr);}}
@media(max-width:600px){.g2,.g3,.g4,.g5{grid-template-columns:1fr;}.sidebar{transform:translateX(-100%);z-index:100;}.sidebar.open{transform:translateX(0);}.main{margin-left:0;}.mobile-toggle{display:flex!important;}}
.mobile-toggle{display:none;position:fixed;top:12px;left:12px;z-index:50;background:#fff;border:1px solid var(--border);border-radius:8px;padding:8px 12px;font-size:16px;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.1);}
.btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:6px;font-size:13px;font-weight:500;cursor:pointer;border:none;transition:all .15s;}
.btn-p{background:var(--primary);color:#fff;}.btn-p:hover{background:var(--primary-dark);}
.btn-s{background:#fff;color:var(--text);border:1px solid var(--border);}.btn-s:hover{background:var(--surface);}
.btn-sm{padding:5px 10px;font-size:12px;}
.badge{display:inline-flex;align-items:center;gap:3px;padding:2px 8px;border-radius:12px;font-size:10px;font-weight:600;}
.b-green{background:var(--green-bg);color:var(--green);}
.b-yellow{background:var(--amber-bg);color:var(--amber);}
.b-red{background:var(--red-bg);color:var(--red);}
.b-blue{background:rgba(37,99,235,.1);color:var(--primary);}
.b-gray{background:var(--surface);color:var(--text3);}
.b-demo{background:#fef3c7;color:#92400e;font-size:9px;}
.b-real{background:var(--green-bg);color:var(--green);font-size:9px;}
.metric{padding:14px;}.metric-l{font-size:11px;color:var(--text3);}.metric-v{font-size:26px;font-weight:700;margin-top:2px;}.metric-n{font-size:9px;color:var(--text3);margin-top:2px;}
.proj-card{padding:14px;cursor:pointer;transition:box-shadow .15s;}.proj-card:hover{box-shadow:0 4px 12px rgba(0,0,0,.08);}
.proj-name{font-size:13px;font-weight:600;margin-bottom:3px;}.proj-meta{font-size:11px;color:var(--text3);display:flex;gap:8px;flex-wrap:wrap;}
.progress{height:5px;background:var(--surface);border-radius:3px;overflow:hidden;margin-top:6px;}.progress-fill{height:100%;border-radius:3px;}
.tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:20px;overflow-x:auto;}
.tab{padding:10px 14px;font-size:13px;font-weight:500;color:var(--text2);cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;}
.tab:hover{color:var(--text);}.tab.active{color:var(--primary);border-bottom-color:var(--primary);}
.timeline{position:relative;padding-left:28px;}.timeline::before{content:'';position:absolute;left:9px;top:0;bottom:0;width:2px;background:var(--border);}
.tl-item{position:relative;margin-bottom:20px;}.tl-dot{position:absolute;left:-28px;top:2px;width:22px;height:22px;border-radius:50%;border:2px solid var(--border);background:#fff;display:flex;align-items:center;justify-content:center;font-size:9px;}
.tl-dot.blue{border-color:var(--primary);background:rgba(37,99,235,.1);}.tl-dot.green{border-color:var(--green);background:var(--green-bg);}.tl-dot.yellow{border-color:var(--amber);background:var(--amber-bg);}.tl-dot.red{border-color:var(--red);background:var(--red-bg);}
.map-area{background:linear-gradient(135deg,#e0f2fe 0%,#dbeafe 50%,#e0e7ff 100%);border:2px dashed var(--border);border-radius:12px;height:380px;position:relative;overflow:hidden;}
.map-marker{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#fff;position:absolute;cursor:pointer;transition:transform .2s;}.map-marker:hover{transform:scale(1.15);}
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:60;align-items:center;justify-content:center;padding:16px;}
.modal-bg.show{display:flex;}
.modal{background:#fff;border-radius:12px;max-width:520px;width:100%;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.2);}
.modal-hdr{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border);}
.modal-body{padding:20px;}.modal-foot{padding:14px 20px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:8px;}
.fg{margin-bottom:14px;}.fl{display:block;font-size:13px;font-weight:500;margin-bottom:3px;}
.fi,.fs,.ft{width:100%;padding:7px 10px;border:1px solid var(--border);border-radius:6px;font-size:13px;outline:none;}
.fi:focus,.fs:focus,.ft:focus{border-color:var(--primary);box-shadow:0 0 0 2px rgba(37,99,235,.1);}
.ft{min-height:60px;resize:vertical;}
.trust{display:inline-flex;align-items:center;gap:2px;padding:1px 5px;border-radius:3px;font-size:8px;font-weight:700;letter-spacing:.03em;}
.trust-ai{background:var(--amber-bg);color:var(--amber);}.trust-eng{background:var(--green-bg);color:var(--green);}.trust-self{background:var(--surface);color:var(--text3);}.trust-photo{background:rgba(37,99,235,.1);color:var(--primary);}
.landing-nav{display:flex;align-items:center;justify-content:space-between;padding:14px 0;border-bottom:1px solid var(--border);}
.hero{padding:60px 0 40px;}.hero h1{font-size:44px;font-weight:700;line-height:1.1;}.hero .sub{font-size:18px;color:var(--text2);margin-top:12px;}.hero .desc{font-size:15px;color:var(--text3);margin-top:12px;max-width:600px;line-height:1.6;}
.section-t{font-size:20px;font-weight:700;margin-bottom:14px;}.divider{border-top:1px solid var(--border);margin:40px 0;}
.feature-icon{width:40px;height:40px;border-radius:8px;background:rgba(37,99,235,.1);display:flex;align-items:center;justify-content:center;font-size:18px;margin-bottom:10px;}
.table-wrap{overflow-x:auto;}
table{width:100%;font-size:13px;border-collapse:collapse;}
th{text-align:left;padding:10px;color:var(--text3);font-weight:500;border-bottom:1px solid var(--border);}
td{padding:10px;border-bottom:1px solid var(--border);}
.empty{text-align:center;padding:40px;color:var(--text3);font-size:13px;}
.alert-bar{padding:10px 14px;border-radius:6px;font-size:11px;margin-bottom:16px;}
.alert-warn{background:var(--amber-bg);border:1px solid rgba(217,119,6,.2);color:var(--amber);}
.alert-info{background:rgba(37,99,235,.05);border:1px solid rgba(37,99,235,.15);color:var(--primary);}
.alert-error{background:var(--red-bg);border:1px solid rgba(220,38,38,.15);color:var(--red);}
.alert-success{background:var(--green-bg);border:1px solid rgba(5,150,105,.15);color:var(--green);}
.toast{position:fixed;bottom:20px;right:20px;background:var(--green);color:#fff;padding:12px 20px;border-radius:8px;font-size:13px;font-weight:500;z-index:100;display:none;box-shadow:0 4px 12px rgba(0,0,0,.15);}
.toast.show{display:block;animation:fadeInUp .3s;}
@keyframes fadeInUp{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
/* CEDI Demo */
.demo-overlay{display:none;position:fixed;inset:0;background:#fff;z-index:200;overflow-y:auto;}
.demo-overlay.show{display:block;}
.demo-nav{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--border);padding:12px 24px;display:flex;align-items:center;justify-content:space-between;z-index:10;}
.demo-nav-left{display:flex;align-items:center;gap:12px;}
.demo-progress{width:200px;height:4px;background:var(--surface);border-radius:2px;overflow:hidden;}
.demo-progress-fill{height:100%;background:var(--primary);border-radius:2px;transition:width .3s;}
.demo-step-label{font-size:12px;color:var(--text3);}
.demo-body{max-width:800px;margin:0 auto;padding:40px 24px 80px;}
.demo-step{display:none;}
.demo-step.active{display:block;animation:fadeInUp .4s;}
.demo-title{font-size:32px;font-weight:700;margin-bottom:8px;}
.demo-subtitle{font-size:16px;color:var(--text2);margin-bottom:24px;line-height:1.6;}
.demo-narration{background:var(--surface);border-left:3px solid var(--primary);padding:12px 16px;border-radius:0 8px 8px 0;margin:20px 0;font-size:14px;color:var(--text2);line-height:1.7;font-style:italic;}
.demo-card{background:#fff;border:1px solid var(--border);border-radius:10px;padding:20px;margin-bottom:16px;box-shadow:0 1px 3px rgba(0,0,0,.06);}
.demo-flow{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:16px 0;}
.demo-flow-item{padding:6px 12px;border-radius:6px;font-size:12px;font-weight:600;background:rgba(37,99,235,.08);color:var(--primary);}
.demo-flow-arrow{color:var(--text3);font-size:14px;}
.demo-badge-big{display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:700;letter-spacing:.03em;}
.demo-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;border:none;transition:all .15s;}
.demo-btn-p{background:var(--primary);color:#fff;}.demo-btn-p:hover{background:var(--primary-dark);}
.demo-btn-s{background:#fff;color:var(--text);border:1px solid var(--border);}.demo-btn-s:hover{background:var(--surface);}
.demo-grid{display:grid;gap:12px;}
.demo-grid-2{grid-template-columns:1fr 1fr;}
.demo-grid-3{grid-template-columns:1fr 1fr 1fr;}
@media(max-width:600px){.demo-grid-2,.demo-grid-3{grid-template-columns:1fr;}.demo-title{font-size:24px;}}
</style>
</head>
<body>
<button class="mobile-toggle" onclick="document.querySelector('.sidebar').classList.toggle('open')">☰</button>

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- LANDING PAGE -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div id="landing" class="page active" style="margin-left:0;max-width:900px;margin:0 auto;padding:0 20px;">
  <nav class="landing-nav">
    <div style="display:flex;align-items:center;gap:8px;"><span style="font-size:22px;">🏗️</span><span style="font-size:17px;font-weight:700;">BuildMe</span></div>
    <div style="display:flex;gap:14px;align-items:center;">
      <a href="#" onclick="nav('dashboard')" style="font-size:13px;color:var(--text2);text-decoration:none;">Sign In</a>
      <button class="btn btn-p" onclick="nav('dashboard')">Get Started</button>
    </div>
  </nav>
  <section class="hero">
    <h1>BuildMe</h1>
    <p class="sub">AI + Spatial Intelligence for Residential Construction & Property Decisions</p>
    <p class="desc">BuildMe connects homeowners, engineers and contractors through AI-assisted inspections, spatial intelligence, quotation analysis and evidence-based construction management.</p>
    <div style="display:flex;gap:12px;margin-top:28px;flex-wrap:wrap;">
      <button class="btn btn-p" onclick="nav('projects')" style="padding:10px 20px;font-size:15px;">Start Building →</button>
      <button class="btn btn-s" onclick="nav('property-intel')" style="padding:10px 20px;font-size:15px;">Evaluate a Property</button>
    </div>
  </section>
  <div class="divider"></div>
  <h2 class="section-t">One Platform. Two Journeys.</h2>
  <div class="grid g2" style="margin-bottom:40px;">
    <div class="card" style="border-left:4px solid var(--primary);"><div class="card-body">
      <h3 style="font-size:15px;font-weight:600;color:var(--primary);margin-bottom:6px;">🏗️ BUILD</h3>
      <p style="font-size:13px;color:var(--text2);margin-bottom:12px;">Manage a property that is being constructed.</p>
      <div style="display:flex;flex-wrap:wrap;gap:5px;"><span class="badge b-blue">Plan</span><span class="badge b-blue">Estimate</span><span class="badge b-blue">Quote</span><span class="badge b-blue">Construct</span><span class="badge b-blue">Inspect</span><span class="badge b-blue">Monitor</span><span class="badge b-blue">Resolve</span></div>
    </div></div>
    <div class="card" style="border-left:4px solid var(--green);"><div class="card-body">
      <h3 style="font-size:15px;font-weight:600;color:var(--green);margin-bottom:6px;">🏠 BUY</h3>
      <p style="font-size:13px;color:var(--text2);margin-bottom:12px;">Evaluate a ready-built property before making a decision.</p>
      <div style="display:flex;flex-wrap:wrap;gap:5px;"><span class="badge b-green">Locate</span><span class="badge b-green">Inspect</span><span class="badge b-green">Analyze</span><span class="badge b-green">Verify</span><span class="badge b-green">Review</span><span class="badge b-green">Decide</span></div>
    </div></div>
  </div>
  <div class="divider"></div>
  <h2 class="section-t">Technology</h2>
  <div class="grid g3" style="margin-bottom:40px;">
    <div class="card"><div class="card-body"><div class="feature-icon">🤖</div><h3 style="font-size:15px;font-weight:600;margin-bottom:6px;">AI / ML</h3><p style="font-size:13px;color:var(--text2);line-height:1.6;">Image Analysis · Document Intelligence · Future Cost Prediction</p></div></div>
    <div class="card"><div class="card-body"><div class="feature-icon">📍</div><h3 style="font-size:15px;font-weight:600;margin-bottom:6px;">Spatial Intelligence</h3><p style="font-size:13px;color:var(--text2);line-height:1.6;">GPS · Maps · Site Context · Location-Aware Analysis</p></div></div>
    <div class="card"><div class="card-body"><div class="feature-icon">🛡️</div><h3 style="font-size:15px;font-weight:600;margin-bottom:6px;">Evidence Intelligence</h3><p style="font-size:13px;color:var(--text2);line-height:1.6;">Photos · Timestamps · Inspections · Audit Timeline · Human Review</p></div></div>
  </div>
  <div class="divider"></div>
  <h2 class="section-t">Human + AI</h2>
  <div class="card" style="margin-bottom:40px;border-left:4px solid var(--primary);"><div class="card-body" style="display:flex;flex-wrap:wrap;gap:20px;align-items:center;">
    <div style="flex:1;min-width:260px;">
      <p style="font-size:15px;line-height:1.7;"><strong>AI assists.</strong> Engineers review. Homeowners participate. Contractors respond. BuildMe records the evidence.</p>
      <p style="font-size:11px;color:var(--red);margin-top:10px;font-weight:600;">BuildMe does not replace professional engineering judgment.</p>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;"><span class="badge b-blue">🤖 AI</span><span class="badge b-green">👷 Engineer</span><span class="badge b-yellow">🏠 Homeowner</span><span class="badge b-gray">🔨 Contractor</span></div>
  </div></div>
  <div style="border-top:1px solid var(--border);padding:24px 0;display:flex;justify-content:space-between;font-size:13px;color:var(--text3);"><div style="display:flex;align-items:center;gap:6px;">🏗️ BuildMe</div><p>© 2026 BuildMe. All rights reserved.</p></div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- APP SHELL -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div id="app-shell" style="display:none;">
  <aside class="sidebar">
    <div class="sidebar-header"><span style="font-size:22px;">🏗️</span><h1>BuildMe</h1></div>
    <nav class="sidebar-nav">
      <div class="nav-sec"><div class="nav-sec-title">Main</div>
        <button class="nav-item active" data-page="dashboard" onclick="nav('dashboard')">🏠 Dashboard</button>
        <button class="nav-item" data-page="projects" onclick="nav('projects')">🏗️ Projects</button>
        <button class="nav-item" data-page="spatial" onclick="nav('spatial')">📍 Spatial Intelligence</button>
        <button class="nav-item" data-page="inspections" onclick="nav('inspections')">📷 Inspections</button>
      </div>
      <div class="nav-sec"><div class="nav-sec-title">Intelligence</div>
        <button class="nav-item" data-page="ai" onclick="nav('ai')">🤖 AI Intelligence</button>
        <button class="nav-item" data-page="cost" onclick="nav('cost')">💰 Cost Intelligence</button>
        <button class="nav-item" data-page="quotations" onclick="nav('quotations')">📄 Quotations</button>
      </div>
      <div class="nav-sec"><div class="nav-sec-title">Property</div>
        <button class="nav-item" data-page="property-intel" onclick="nav('property-intel')">🏠 Property Intelligence</button>
        <button class="nav-item" data-page="evidence" onclick="nav('evidence')">⚠️ Issues & Evidence</button>
        <button class="nav-item" data-page="workforce" onclick="nav('workforce')">👷 Workforce</button>
      </div>
      <div class="nav-sec"><div class="nav-sec-title">Business</div>
        <button class="nav-item" data-page="business" onclick="nav('business')">💼 Business & Validation</button>
      </div>
      <div class="nav-sec" style="margin-top:auto;padding-top:12px;border-top:1px solid var(--border);">
        <button class="nav-item" onclick="openDemo()" style="background:var(--primary);color:#fff;font-weight:600;">🎯 CEDI Demo</button>
      </div>
    </nav>
  </aside>

  <div class="main">

    <!-- ═══════════ DASHBOARD ═══════════ -->
    <div id="pg-dashboard" class="page active">
      <div class="page-hdr"><h2>BuildMe Command Center</h2><p>Manage construction, inspections, property intelligence and evidence from one place.</p></div>

      <!-- CEDI Demo Guide -->
      <div class="card" style="margin-bottom:16px;border-left:4px solid var(--primary);">
        <div class="card-body">
          <h3 style="font-size:14px;font-weight:600;margin-bottom:6px;">🎬 CEDI Demo — Recommended Flow</h3>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('projects')">1. Construction Project</span>
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('spatial')">2. Spatial Intelligence</span>
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('quotations')">3. Real Quotation</span>
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('cost')">4. Cost Estimate</span>
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('inspections')">5. Site Inspection</span>
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('ai')">6. AI Analysis</span>
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('evidence')">7. Evidence</span>
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('evidence')">8. Issue Resolution</span>
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('workforce')">9. Workforce Verification</span>
            <span class="badge b-blue" style="cursor:pointer;padding:4px 8px;" onclick="nav('business')">10. Business Validation</span>
          </div>
        </div>
      </div>

      <div class="grid g5" style="margin-bottom:16px;">
        <div class="card metric"><div class="metric-l">Active Projects</div><div class="metric-v" style="color:var(--primary);">5</div><div class="metric-n"><span class="badge b-demo">DEMO DATA</span></div></div>
        <div class="card metric"><div class="metric-l">Pending Inspections</div><div class="metric-v" style="color:var(--amber);">3</div></div>
        <div class="card metric"><div class="metric-l">Open Issues</div><div class="metric-v" style="color:var(--red);">5</div></div>
        <div class="card metric"><div class="metric-l">AI Observations</div><div class="metric-v">7</div></div>
        <div class="card metric"><div class="metric-l">Properties Evaluated</div><div class="metric-v" style="color:var(--green);">4</div></div>
      </div>

      <div class="grid" style="grid-template-columns:2fr 1fr;gap:12px;">
        <div class="card">
          <div class="card-hdr" style="display:flex;justify-content:space-between;align-items:center;"><h3 style="font-size:14px;font-weight:600;">Recent Activity</h3><span class="badge b-demo">DEMO DATA</span></div>
          <div class="card-body"><div class="timeline">
