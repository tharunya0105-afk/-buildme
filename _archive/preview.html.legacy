      <div class="card" style="margin-bottom:10px;"><div class="card-body"><div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px;"><span style="font-size:10px;font-family:monospace;color:var(--text3);background:var(--surface);padding:1px 5px;border-radius:3px;">BM-002</span><span style="font-size:13px;font-weight:600;">Wall crack observation — North wall</span><span class="badge b-yellow">UNDER REVIEW</span><span class="badge b-red">HIGH</span></div><p style="font-size:11px;color:var(--text3);">Structural · 24 Aug 2026 · BuildMe AI · <span class="trust trust-ai">AI-ASSISTED</span></p></div></div>
      <div class="card" style="margin-bottom:10px;"><div class="card-body"><div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px;"><span style="font-size:10px;font-family:monospace;color:var(--text3);background:var(--surface);padding:1px 5px;border-radius:3px;">BM-003</span><span style="font-size:13px;font-weight:600;">Material delivery delay</span><span class="badge b-green">RESOLVED</span><span class="badge b-yellow">MEDIUM</span></div><p style="font-size:11px;color:var(--text3);">Delay · 18 Aug 2026 · Suresh Contractor</p></div></div>
