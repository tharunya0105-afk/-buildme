<div id="modal-project" class="modal-bg" onclick="closeModal(this,event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-hdr"><h3 style="font-size:16px;font-weight:600;">New Construction Project</h3><button onclick="closeModal(document.getElementById('modal-project'))" style="background:none;border:none;font-size:18px;cursor:pointer;color:var(--text3);">✕</button></div>
    <div class="modal-body">
      <div class="fg"><label class="fl">Project Name *</label><input type="text" class="fi" placeholder="e.g., Kumar Residence" id="proj-name"></div>
      <div class="grid g2"><div class="fg"><label class="fl">City</label><input type="text" class="fi" placeholder="e.g., Trichy"></div><div class="fg"><label class="fl">State</label><input type="text" class="fi" value="Tamil Nadu"></div></div>
      <div class="fg"><label class="fl">Homeowner Name</label><input type="text" class="fi" placeholder="e.g., Kumar"></div>
      <div class="fg"><label class="fl">Construction Type</label><select class="fs"><option>Individual House</option><option>Villa</option><option>Apartment</option><option>Renovation</option></select></div>
      <div class="grid g2"><div class="fg"><label class="fl">Built-up Area (sq.ft)</label><input type="number" class="fi" placeholder="e.g., 2000"></div><div class="fg"><label class="fl">Estimated Cost (₹)</label><input type="number" class="fi" placeholder="e.g., 4500000"></div></div>
    </div>
    <div class="modal-foot"><button class="btn btn-s" onclick="closeModal(document.getElementById('modal-project'))">Cancel</button><button class="btn btn-p" onclick="if(!document.getElementById('proj-name').value){alert('Please enter a project name');return;}showToast('Project created (demo)');closeModal(document.getElementById('modal-project'))">Create Project</button></div>
  </div>
</div>

<div id="modal-inspection" class="modal-bg" onclick="closeModal(this,event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-hdr"><h3 style="font-size:16px;font-weight:600;">New Inspection</h3><button onclick="closeModal(document.getElementById('modal-inspection'))" style="background:none;border:none;font-size:18px;cursor:pointer;color:var(--text3);">✕</button></div>
    <div class="modal-body">
      <div class="fg"><label class="fl">Project *</label><select class="fs"><option>Kumar Residence</option><option>Priya Villa</option><option>Ravi Tower</option><option>Lakshmi Renovation</option><option>Saravanan Homes</option></select></div>
      <div class="fg"><label class="fl">Inspection Date</label><input type="date" class="fi" value="2026-08-28"></div>
      <div class="fg"><label class="fl">Construction Stage</label><select class="fs"><option>Planning</option><option>Foundation</option><option>Structure</option><option>Brickwork</option><option>Roofing</option><option>Electrical/Plumbing</option><option>Finishing</option></select></div>
      <div class="fg"><label class="fl">Notes</label><textarea class="ft" placeholder="Inspection notes..."></textarea></div>
      <div class="fg"><label class="fl">Upload Photos</label><div style="border:2px dashed var(--border);border-radius:6px;padding:20px;text-align:center;cursor:pointer;"><span style="font-size:12px;color:var(--text3);">📷 Click to upload inspection photos</span></div></div>
    </div>
    <div class="modal-foot"><button class="btn btn-s" onclick="closeModal(document.getElementById('modal-inspection'))">Cancel</button><button class="btn btn-p" onclick="showToast('Inspection created (demo)');closeModal(document.getElementById('modal-inspection'))">Create Inspection</button></div>
  </div>
</div>

<div id="modal-issue" class="modal-bg" onclick="closeModal(this,event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-hdr"><h3 style="font-size:16px;font-weight:600;">Report Issue</h3><button onclick="closeModal(document.getElementById('modal-issue'))" style="background:none;border:none;font-size:18px;cursor:pointer;color:var(--text3);">✕</button></div>
    <div class="modal-body">
      <div class="fg"><label class="fl">Issue Title *</label><input type="text" class="fi" placeholder="Brief description" id="issue-title"></div>
      <div class="fg"><label class="fl">Project</label><select class="fs"><option>Kumar Residence</option><option>Priya Villa</option><option>Ravi Tower</option></select></div>
      <div class="grid g2"><div class="fg"><label class="fl">Category</label><select class="fs"><option>Structural</option><option>Water/Dampness</option><option>Electrical</option><option>Plumbing</option><option>Material Quality</option><option>Workmanship</option><option>Delay</option></select></div><div class="fg"><label class="fl">Severity</label><select class="fs"><option>Low</option><option selected>Medium</option><option>High</option></select></div></div>
      <div class="fg"><label class="fl">Description</label><textarea class="ft" placeholder="Detailed description..."></textarea></div>
      <div class="fg"><label class="fl">Evidence</label><div style="border:2px dashed var(--border);border-radius:6px;padding:16px;text-align:center;cursor:pointer;"><span style="font-size:12px;color:var(--text3);">📷 Upload photos or documents</span></div></div>
    </div>
    <div class="modal-foot"><button class="btn btn-s" onclick="closeModal(document.getElementById('modal-issue'))">Cancel</button><button class="btn btn-p" onclick="if(!document.getElementById('issue-title').value){alert('Please enter an issue title');return;}showToast('Issue reported (demo)');closeModal(document.getElementById('modal-issue'))">Submit Issue</button></div>
  </div>
</div>

<div id="modal-checkin" class="modal-bg" onclick="closeModal(this,event)">
  <div class="modal" onclick="event.stopPropagation()">
    <div class="modal-hdr"><h3 style="font-size:16px;font-weight:600;">Worker Check-in</h3><button onclick="closeModal(document.getElementById('modal-checkin'))" style="background:none;border:none;font-size:18px;cursor:pointer;color:var(--text3);">✕</button></div>
    <div class="modal-body">
      <div class="alert-bar alert-warn">⚠️ Location supports site-presence verification but does not independently prove work performed.</div>
      <div class="fg"><label class="fl">Worker Name *</label><input type="text" class="fi" placeholder="e.g., Ramesh" id="worker-name"></div>
      <div class="grid g2"><div class="fg"><label class="fl">Role</label><select class="fs"><option>Mason</option><option>Electrician</option><option>Plumber</option><option>Carpenter</option><option>Helper</option></select></div><div class="fg"><label class="fl">Site</label><select class="fs"><option>Kumar Residence</option><option>Priya Villa</option><option>Ravi Tower</option></select></div></div>
      <div class="fg"><label class="fl">Check-in Time</label><input type="time" class="fi" value="08:30"></div>
    </div>
    <div class="modal-foot"><button class="btn btn-s" onclick="closeModal(document.getElementById('modal-checkin'))">Cancel</button><button class="btn btn-p" onclick="if(!document.getElementById('worker-name').value){alert('Please enter worker name');return;}showToast('Worker checked in (demo)');closeModal(document.getElementById('modal-checkin'))">Check In</button></div>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="toast"></div>

<script>
function nav(page){
  document.getElementById('landing').style.display='none';
  document.getElementById('app-shell').style.display='block';
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  const t=document.getElementById('pg-'+page);
  if(t)t.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(i=>{i.classList.remove('active');if(i.dataset.page===page)i.classList.add('active');});
  document.querySelector('.sidebar').classList.remove('open');
  window.scrollTo(0,0);
}
function stab(el,id){
  el.parentElement.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  document.querySelectorAll('.tc').forEach(c=>c.style.display='none');
  const t=document.getElementById(id);if(t)t.style.display='block';
}
function openModal(id){document.getElementById(id).classList.add('show');}
function closeModal(el,ev){if(ev&&ev.target!==ev.currentTarget)return;el.classList.remove('show');}
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000);}
document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.modal-bg.show').forEach(m=>m.classList.remove('show'));});
</script>
<!-- CEDI Demo Overlay -->
<div id="demo-overlay" class="demo-overlay">
  <div class="demo-nav">
    <div class="demo-nav-left">
      <button class="demo-btn demo-btn-s" onclick="closeDemo()" style="padding:6px 12px;font-size:12px;">✕ Exit</button>
      <span style="font-size:15px;font-weight:700;">🏗️ BuildMe Demo</span>
    </div>
    <div style="display:flex;align-items:center;gap:12px;">
      <span id="demo-step-label" class="demo-step-label">Step 1 / 9</span>
      <div class="demo-progress"><div id="demo-progress-fill" class="demo-progress-fill" style="width:11%;"></div></div>
    </div>
    <div style="display:flex;gap:8px;">
      <button class="demo-btn demo-btn-s" id="demo-prev" onclick="demoNav(-1)" style="padding:6px 14px;font-size:12px;">← Back</button>
      <button class="demo-btn demo-btn-p" id="demo-next" onclick="demoNav(1)" style="padding:6px 14px;font-size:12px;">Next →</button>
    </div>
  </div>

  <div class="demo-body">
    <!-- STEP 1: INTRO -->
    <div class="demo-step active" data-step="1">
      <div style="text-align:center;margin-bottom:32px;">
        <div style="font-size:48px;margin-bottom:12px;">🏗️</div>
        <h1 class="demo-title" style="font-size:36px;">BuildMe</h1>
        <p class="demo-subtitle" style="max-width:500px;margin:0 auto;">AI + Spatial Intelligence for Residential Construction & Property Decisions</p>
      </div>
      <div class="demo-grid demo-grid-3" style="margin-bottom:32px;">
        <div class="demo-card" style="text-align:center;border-top:3px solid var(--primary);">
          <div style="font-size:28px;margin-bottom:8px;">🏗️</div>
          <h3 style="font-size:16px;font-weight:700;margin-bottom:6px;">BUILD</h3>
          <p style="font-size:13px;color:var(--text2);">Manage and monitor residential construction projects from planning to completion.</p>
        </div>
        <div class="demo-card" style="text-align:center;border-top:3px solid var(--green);">
          <div style="font-size:28px;margin-bottom:8px;">🏠</div>
          <h3 style="font-size:16px;font-weight:700;margin-bottom:6px;">BUY</h3>
          <p style="font-size:13px;color:var(--text2);">Evaluate ready-built properties before making a purchase decision.</p>
        </div>
        <div class="demo-card" style="text-align:center;border-top:3px solid var(--amber);">
          <div style="font-size:28px;margin-bottom:8px;">🛡️</div>
          <h3 style="font-size:16px;font-weight:700;margin-bottom:6px;">TRUST</h3>
          <p style="font-size:13px;color:var(--text2);">Create evidence-based records between homeowners, engineers and contractors.</p>
        </div>
      </div>
      <div style="text-align:center;"><button class="demo-btn demo-btn-p" onclick="demoNav(1)" style="font-size:16px;padding:14px 28px;">Start 5-Minute Demo →</button></div>
    </div>

    <!-- STEP 2: CREATE PROJECT -->
    <div class="demo-step" data-step="2">
      <span class="demo-badge-big b-blue" style="margin-bottom:8px;">STEP 1 — CREATE PROJECT</span>
      <h1 class="demo-title">Construction Project</h1>
      <p class="demo-subtitle">BuildMe creates a digital record for the entire residential construction project.</p>
      <div class="demo-card">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;">
          <div><h3 style="font-size:18px;font-weight:700;">Demo Residence</h3><p style="font-size:13px;color:var(--text3);margin-top:2px;">📍 Trichy, Tamil Nadu, India</p></div>
          <span class="demo-badge-big b-red">REVIEW NEEDED</span>
        </div>
        <div class="demo-grid demo-grid-3">
          <div><div style="font-size:11px;color:var(--text3);">Homeowner</div><div style="font-size:14px;font-weight:600;">Kumar S.</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Engineer</div><div style="font-size:14px;font-weight:600;">Raj Engineer</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Construction Stage</div><div style="font-size:14px;font-weight:600;">Roofing</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Built-up Area</div><div style="font-size:14px;font-weight:600;">2,200 sq ft</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Progress</div><div style="font-size:14px;font-weight:600;">68%</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Status</div><div style="font-size:14px;font-weight:600;color:var(--red);">Attention Required</div></div>
        </div>
        <div style="margin-top:12px;"><span class="demo-badge-big b-demo">DEMO DATA</span></div>
      </div>
      <div class="demo-narration">Instead of construction information being scattered across WhatsApp and personal records, BuildMe creates a centralized digital record for every project.</div>
    </div>

    <!-- STEP 3: SPATIAL INTELLIGENCE -->
    <div class="demo-step" data-step="3">
      <span class="demo-badge-big b-blue" style="margin-bottom:8px;">STEP 2 — SPATIAL INTELLIGENCE</span>
      <h1 class="demo-title">Spatial Intelligence</h1>
      <p class="demo-subtitle">Location is treated as part of the project intelligence rather than just an address.</p>
      <div class="demo-card" style="overflow:hidden;">
        <div style="background:linear-gradient(135deg,#e0f2fe,#dbeafe,#e0e7ff);border-radius:8px;height:240px;position:relative;display:flex;align-items:center;justify-content:center;">
          <div style="text-align:center;z-index:1;"><div style="font-size:36px;">🗺️</div><p style="font-size:14px;font-weight:600;color:var(--text2);">Interactive Map with Project Markers</p><span class="demo-badge-big b-demo">DEMO DATA</span></div>
          <div style="position:absolute;top:40%;left:55%;width:28px;height:28px;border-radius:50%;background:var(--red);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700;" title="Demo Residence">D</div>
          <div style="position:absolute;top:30%;left:70%;width:28px;height:28px;border-radius:50%;background:var(--green);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700;">P</div>
          <div style="position:absolute;top:55%;left:42%;width:28px;height:28px;border-radius:50%;background:var(--amber);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700;">R</div>
        </div>
      </div>
      <div class="demo-grid demo-grid-3" style="margin-top:12px;">
        <div class="demo-card"><div style="font-size:11px;color:var(--text3);">Site Location</div><div style="font-size:14px;font-weight:600;">Trichy, Tamil Nadu</div></div>
        <div class="demo-card"><div style="font-size:11px;color:var(--text3);">Last Inspection</div><div style="font-size:14px;font-weight:600;">28 Aug 2026</div></div>
        <div class="demo-card"><div style="font-size:11px;color:var(--text3);">Open Issues</div><div style="font-size:14px;font-weight:600;color:var(--red);">2 issues</div></div>
      </div>
      <div class="demo-flow"><span class="demo-flow-item">Property</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">Location</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">Site</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">Inspection</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">Issue</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">Evidence</span></div>
      <div class="demo-narration">BuildMe uses property location as a foundation for construction intelligence — connecting spatial data with project activity.</div>
    </div>

    <!-- STEP 4: QUOTATION -->
    <div class="demo-step" data-step="4">
      <span class="demo-badge-big b-blue" style="margin-bottom:8px;">STEP 3 — QUOTATION INTELLIGENCE</span>
      <h1 class="demo-title">Quotation Intelligence</h1>
      <p class="demo-subtitle">BuildMe organizes construction quotations so homeowners and professionals can understand and compare project costs.</p>
      <div class="demo-card" style="border-left:3px solid var(--green);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><h3 style="font-size:15px;font-weight:700;">Quotation 1 — ₹5,80,000</h3><span class="demo-badge-big b-real">REAL DATA</span></div>
        <p style="font-size:12px;color:var(--text3);">Engineer: B. Saravanan · Madurai</p>
        <p style="font-size:13px;color:var(--text2);margin-top:6px;">Scope: Brickwork, wall plastering, plumbing, woodwork, painting</p>
        <p style="font-size:13px;color:var(--text2);">15 line items · Materials + Labour included</p>
      </div>
      <div class="demo-card" style="border-left:3px solid var(--green);">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><h3 style="font-size:15px;font-weight:700;">Quotation 2 — ₹15,00,000</h3><span class="demo-badge-big b-real">REAL DATA</span></div>
        <p style="font-size:12px;color:var(--text3);">2,000 sq.ft house construction</p>
        <p style="font-size:13px;color:var(--text2);margin-top:6px;">Scope: Foundation through finishing (15 major categories)</p>
        <p style="font-size:13px;color:var(--text2);">Rate: ₹7,500/sq.ft (all-inclusive)</p>
      </div>
      <div class="demo-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><h3 style="font-size:15px;font-weight:700;">Quotation 3 — ₹1,80,000</h3><span class="demo-badge-big b-real">REAL DATA</span></div>
        <p style="font-size:12px;color:var(--text3);">Renovation scope — Electrical, plumbing, woodwork, painting</p>
        <p style="font-size:13px;color:var(--text2);margin-top:6px;">Detailed line-item breakdown with quantities</p>
      </div>
      <div class="demo-narration">These are real engineer quotations extracted from actual PDF documents. BuildMe helps compare scope, pricing, and completeness across multiple quotes.</div>
    </div>

    <!-- STEP 5: INSPECTION -->
    <div class="demo-step" data-step="5">
      <span class="demo-badge-big b-blue" style="margin-bottom:8px;">STEP 4 — SITE INSPECTION</span>
      <h1 class="demo-title">Site Inspection</h1>
      <p class="demo-subtitle">Instead of construction information being scattered across WhatsApp and personal records, inspections create a structured project history.</p>
      <div class="demo-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;"><h3 style="font-size:15px;font-weight:700;">Inspection INS-042</h3><span class="demo-badge-big b-green">COMPLETED</span></div>
        <div class="demo-grid demo-grid-3">
          <div><div style="font-size:11px;color:var(--text3);">Date</div><div style="font-size:13px;font-weight:600;">28 Aug 2026</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Engineer</div><div style="font-size:13px;font-weight:600;">Raj Engineer</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Stage</div><div style="font-size:13px;font-weight:600;">Roofing</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Photos</div><div style="font-size:13px;font-weight:600;">6 captured</div></div>
          <div><div style="font-size:11px;color:var(--text3);">AI Observations</div><div style="font-size:13px;font-weight:600;color:var(--amber);">2 detected</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Status</div><div style="font-size:13px;font-weight:600;">Reviewed by engineer</div></div>
        </div>
        <div style="margin-top:12px;padding:10px;background:var(--surface);border-radius:6px;display:flex;gap:8px;align-items:center;">
          <div style="width:60px;height:45px;background:var(--border);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:16px;">📷</div>
          <div style="width:60px;height:45px;background:var(--border);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:16px;">📷</div>
          <div style="width:60px;height:45px;background:var(--border);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:16px;">📷</div>
          <div style="width:60px;height:45px;background:var(--border);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--text3);">+3</div>
          <span class="demo-badge-big b-demo">DEMO DATA</span>
        </div>
      </div>
      <div class="demo-narration">Each inspection creates a timestamped, structured record with photos, observations, and AI-assisted analysis — replacing ad-hoc WhatsApp messages.</div>
    </div>

    <!-- STEP 6: AI -->
    <div class="demo-step" data-step="6">
      <span class="demo-badge-big b-blue" style="margin-bottom:8px;">STEP 5 — AI-ASSISTED INSPECTION</span>
      <h1 class="demo-title">AI Intelligence</h1>
      <p class="demo-subtitle">AI assists with visual analysis. Engineers review and confirm. BuildMe records the evidence.</p>
      <div class="demo-flow" style="margin-bottom:20px;"><span class="demo-flow-item">📸 Photo</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">🤖 AI Analysis</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">📋 Observation</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">📊 Confidence</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">👷 Engineer Review</span></div>
      <div class="demo-card" style="border-left:3px solid var(--amber);">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;"><span class="demo-badge-big b-yellow">AI-ASSISTED</span><span class="demo-badge-big b-red">HUMAN REVIEW RECOMMENDED</span></div>
        <h3 style="font-size:15px;font-weight:700;margin-bottom:6px;">Possible Surface Crack Detected</h3>
        <div class="demo-grid demo-grid-3">
          <div><div style="font-size:11px;color:var(--text3);">Confidence</div><div style="font-size:14px;font-weight:600;">82%</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Severity</div><div style="font-size:14px;font-weight:600;color:var(--amber);">Medium</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Status</div><div style="font-size:14px;font-weight:600;">Pending Engineer Review</div></div>
        </div>
        <div style="margin-top:10px;padding:8px;background:var(--amber-bg);border-radius:6px;border:1px solid rgba(217,119,6,.15);">
          <p style="font-size:11px;color:var(--amber);font-weight:500;">⚠️ AI service not connected — prototype interface shown.</p>
          <p style="font-size:10px;color:var(--text3);margin-top:2px;">Set AI_API_KEY to enable real AI analysis. This demo shows the intended workflow.</p>
        </div>
      </div>
      <div class="demo-card">
        <h4 style="font-size:13px;font-weight:600;margin-bottom:6px;">Why did AI flag this?</h4>
        <div style="font-size:12px;color:var(--text2);display:flex;flex-direction:column;gap:3px;">
          <div>• Visible linear pattern on wall surface</div>
          <div>• Contrast with surrounding surface texture</div>
          <div>• Similarity to known surface crack patterns</div>
        </div>
        <p style="font-size:10px;color:var(--text3);margin-top:6px;">Prototype explanation — not actual model explainability.</p>
      </div>
      <div class="demo-narration">AI assists engineers by identifying possible visible issues. Every observation requires human review. BuildMe never claims AI replaces professional engineering judgment.</div>
    </div>

    <!-- STEP 7: EVIDENCE -->
    <div class="demo-step" data-step="7">
      <span class="demo-badge-big b-blue" style="margin-bottom:8px;">STEP 6 — EVIDENCE & DISPUTES</span>
      <h1 class="demo-title">Evidence Trail</h1>
      <p class="demo-subtitle">BuildMe does not act as a judge. It creates a shared evidence trail that helps the people involved review what happened.</p>
      <div class="demo-card">
        <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;">Issue Resolution Workflow</h3>
        <div class="demo-flow"><span class="demo-flow-item" style="background:rgba(220,38,38,.1);color:var(--red);">⚠️ Issue Reported</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">📷 Photo Added</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item" style="background:rgba(217,119,6,.1);color:var(--amber);">🤖 AI Observation</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item" style="background:rgba(5,150,105,.1);color:var(--green);">👷 Engineer Review</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item" style="background:rgba(217,119,6,.1);color:var(--amber);">🔨 Contractor Response</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">🏠 Homeowner Response</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item" style="background:rgba(5,150,105,.1);color:var(--green);">✅ Resolution</span></div>
      </div>
      <div class="demo-card">
        <h4 style="font-size:13px;font-weight:600;margin-bottom:8px;">Example Issue</h4>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px;"><span style="font-size:10px;font-family:monospace;background:var(--surface);padding:1px 5px;border-radius:3px;">BM-001</span><span style="font-size:13px;font-weight:600;">Possible dampness near bathroom wall</span><span class="demo-badge-big b-yellow">UNDER REVIEW</span><span class="demo-badge-big b-red">HIGH</span></div>
        <p style="font-size:12px;color:var(--text3);">Water/Dampness · 25 Aug 2026 · Kumar (Homeowner) · 4 evidence items</p>
        <div style="margin-top:10px;display:flex;flex-direction:column;gap:6px;">
          <div style="padding:6px 10px;background:var(--surface);border-radius:6px;font-size:12px;"><span style="font-weight:600;">Homeowner:</span> "I noticed dampness near the shower area." <span class="demo-badge-big b-demo" style="font-size:8px;">SELF-REPORTED</span></div>
          <div style="padding:6px 10px;background:var(--green-bg);border-radius:6px;font-size:12px;"><span style="font-weight:600;">Engineer:</span> "Will inspect during next site visit." <span class="demo-badge-big b-demo" style="font-size:8px;">ENGINEER-REVIEWED</span></div>
          <div style="padding:6px 10px;background:var(--amber-bg);border-radius:6px;font-size:12px;"><span style="font-weight:600;">Contractor:</span> "Waterproofing done as per specification." <span class="demo-badge-big b-demo" style="font-size:8px;">CONTRACTOR RESPONSE</span></div>
        </div>
      </div>
      <div class="demo-narration">Every piece of information clearly indicates its source — self-reported, photo-supported, AI-assisted, engineer-reviewed, or contractor response. BuildMe never determines who is right.</div>
    </div>

    <!-- STEP 8: WORKFORCE -->
    <div class="demo-step" data-step="8">
      <span class="demo-badge-big b-blue" style="margin-bottom:8px;">STEP 7 — WORKFORCE VERIFICATION</span>
      <h1 class="demo-title">Workforce Verification</h1>
      <p class="demo-subtitle">Location-supported check-ins can help identify inconsistencies, but GPS alone does not prove that a person actually performed work.</p>
      <div class="demo-card" style="border-left:3px solid var(--amber);">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;"><span class="demo-badge-big b-yellow">DEMO DATA</span><span class="demo-badge-big b-red">DISCREPANCY DETECTED</span></div>
        <div class="demo-grid demo-grid-3">
          <div><div style="font-size:11px;color:var(--text3);">Expected Workers</div><div style="font-size:20px;font-weight:700;">12</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Check-ins</div><div style="font-size:20px;font-weight:700;color:var(--green);">8</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Discrepancies</div><div style="font-size:20px;font-weight:700;color:var(--red);">2</div></div>
        </div>
      </div>
      <div class="demo-card">
        <h4 style="font-size:13px;font-weight:600;margin-bottom:8px;">Worker Check-in Records</h4>
        <div style="font-size:12px;">
          <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);"><span>Ramesh · Mason</span><span style="color:var(--green);font-weight:600;">✅ Verified 8:30 AM</span></div>
          <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);"><span>Senthil · Electrician</span><span style="color:var(--green);font-weight:600;">✅ Verified 9:00 AM</span></div>
          <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border);"><span>Kumar · Plumber</span><span style="color:var(--green);font-weight:600;">✅ Verified 8:45 AM</span></div>
          <div style="display:flex;justify-content:space-between;padding:6px 0;"><span>Mohan · Helper</span><span style="color:var(--red);font-weight:600;">❌ No Check-in</span></div>
        </div>
        <div style="margin-top:8px;"><span class="demo-badge-big b-demo">DEMO DATA</span></div>
      </div>
      <div class="demo-card" style="background:var(--amber-bg);border-color:rgba(217,119,6,.2);">
        <p style="font-size:12px;color:var(--amber);font-weight:600;">⚠️ Important: Location can support site-presence verification but does not independently prove that a person performed work.</p>
      </div>
      <div class="demo-narration">BuildMe records check-in data as a verification signal — not proof of work performed. This creates transparency without making unsupported claims.</div>
    </div>

    <!-- STEP 9: BUY JOURNEY -->
    <div class="demo-step" data-step="9">
      <span class="demo-badge-big b-blue" style="margin-bottom:8px;">STEP 8 — READY-BUILT PROPERTY</span>
      <h1 class="demo-title">BuildMe for Property Buyers</h1>
      <p class="demo-subtitle">BuildMe can also help someone evaluate a ready-built house before making a purchase decision.</p>
      <div class="demo-flow" style="margin-bottom:16px;"><span class="demo-flow-item">🏠 Property</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">📍 Location</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">📷 Photos</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">🤖 AI Observations</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">✅ Checklist</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">🔴 Attention Items</span><span class="demo-flow-arrow">↓</span><span class="demo-flow-item">👷 Engineer Review</span></div>
      <div class="demo-card">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;"><h3 style="font-size:15px;font-weight:700;">Green Valley Residence</h3><span class="demo-badge-big b-yellow">MODERATE CONCERN</span></div>
        <div class="demo-grid demo-grid-3">
          <div><div style="font-size:11px;color:var(--text3);">Type</div><div style="font-size:13px;font-weight:600;">Independent House</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Location</div><div style="font-size:13px;font-weight:600;">Coimbatore</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Area</div><div style="font-size:13px;font-weight:600;">2,200 sq ft</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Condition Score</div><div style="font-size:13px;font-weight:600;color:var(--amber);">42/100</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Photos</div><div style="font-size:13px;font-weight:600;">14 uploaded</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Checklist</div><div style="font-size:13px;font-weight:600;">70% complete</div></div>
        </div>
      </div>
      <div class="demo-card">
        <h4 style="font-size:13px;font-weight:600;margin-bottom:6px;">Attention Items</h4>
        <div style="display:flex;flex-direction:column;gap:4px;">
          <div style="display:flex;align-items:center;gap:6px;padding:6px 8px;border:1px solid rgba(220,38,38,.15);border-radius:6px;background:var(--red-bg);font-size:12px;"><span style="font-weight:600;color:var(--red);">🔴 HIGH</span>Possible dampness detected — bathroom area <span class="demo-badge-big b-yellow" style="font-size:8px;">AI-ASSISTED</span></div>
          <div style="display:flex;align-items:center;gap:6px;padding:6px 8px;border:1px solid rgba(217,119,6,.15);border-radius:6px;background:var(--amber-bg);font-size:12px;"><span style="font-weight:600;color:var(--amber);">🟡 MEDIUM</span>Visible wall crack — exterior north wall <span class="demo-badge-big b-yellow" style="font-size:8px;">AI-ASSISTED</span></div>
        </div>
      </div>
      <div class="demo-narration">The buyer gets a structured assessment with AI-assisted observations, a due-diligence checklist, and clear attention items — helping them make a more informed decision.</div>
    </div>

    <!-- STEP 10: BUSINESS -->
    <div class="demo-step" data-step="10">
      <span class="demo-badge-big b-blue" style="margin-bottom:8px;">STEP 9 — BUSINESS VALIDATION</span>
      <h1 class="demo-title">Business Validation</h1>
      <p class="demo-subtitle">BuildMe is currently in the validation stage. We do not claim product-market fit or revenue.</p>
      <div class="demo-card" style="background:var(--red-bg);border-color:rgba(220,38,38,.15);">
        <p style="font-size:13px;color:var(--red);font-weight:700;">PRE-REVENUE — VALIDATION STAGE</p>
        <p style="font-size:12px;color:var(--text3);margin-top:2px;">No revenue, customer, or PMF figures are fabricated.</p>
      </div>
      <div class="demo-card">
        <h4 style="font-size:13px;font-weight:600;margin-bottom:8px;">Validation Progress</h4>
        <div class="demo-flow"><span class="demo-flow-item">Problem</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Prototype</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Pilot</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Willingness to Pay</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">First Customer</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Retention</span></div>
        <div class="demo-grid demo-grid-3" style="margin-top:10px;">
          <div><div style="font-size:11px;color:var(--text3);">Users Interviewed</div><div style="font-size:16px;font-weight:700;">5</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Prototype Tested</div><div style="font-size:16px;font-weight:700;">3</div></div>
          <div><div style="font-size:11px;color:var(--text3);">Paying Customers</div><div style="font-size:16px;font-weight:700;color:var(--amber);">0 <span style="font-size:10px;font-weight:400;">NOT YET VALIDATED</span></div></div>
        </div>
      </div>
      <div class="demo-card">
        <h4 style="font-size:13px;font-weight:600;margin-bottom:8px;">Proposed Revenue Models</h4>
        <div style="display:flex;flex-direction:column;gap:4px;font-size:12px;">
          <div style="padding:6px 10px;background:var(--surface);border-radius:6px;">👷 <strong>Engineer Subscription</strong> — Monthly SaaS for multi-site management</div>
          <div style="padding:6px 10px;background:var(--surface);border-radius:6px;">🏠 <strong>Property Reports</strong> — Per-report pricing for property evaluation</div>
          <div style="padding:6px 10px;background:var(--surface);border-radius:6px;">🏢 <strong>Enterprise Services</strong> — Future offering for large portfolios</div>
        </div>
        <div style="margin-top:6px;"><span class="demo-badge-big b-demo">PROPOSED — NOT YET VALIDATED</span></div>
      </div>
      <div class="demo-narration">BuildMe is transparent about what has been validated and what is still being tested. We will not claim traction until customers actually pay.</div>
    </div>

    <!-- STEP 11: FINAL -->
    <div class="demo-step" data-step="11">
      <div style="text-align:center;margin-bottom:32px;">
        <div style="font-size:48px;margin-bottom:12px;">🏗️</div>
        <h1 class="demo-title" style="font-size:36px;">BuildMe</h1>
        <p class="demo-subtitle" style="max-width:500px;margin:0 auto;">One Platform. Two Journeys.</p>
      </div>
      <div class="demo-grid demo-grid-2" style="margin-bottom:24px;">
        <div class="demo-card" style="border-left:4px solid var(--primary);">
          <h3 style="font-size:17px;font-weight:700;color:var(--primary);margin-bottom:8px;">🏗️ BUILD</h3>
          <div class="demo-flow" style="margin:0;"><span class="demo-flow-item">Plan</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Estimate</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Quote</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Construct</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Inspect</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Monitor</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Resolve</span></div>
        </div>
        <div class="demo-card" style="border-left:4px solid var(--green);">
          <h3 style="font-size:17px;font-weight:700;color:var(--green);margin-bottom:8px;">🏠 BUY</h3>
          <div class="demo-flow" style="margin:0;"><span class="demo-flow-item">Locate</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Inspect</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Analyze</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Verify</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Review</span><span class="demo-flow-arrow">→</span><span class="demo-flow-item">Decide</span></div>
        </div>
      </div>
      <div class="demo-card" style="text-align:center;">
        <p style="font-size:13px;color:var(--text3);margin-bottom:10px;">Powered by</p>
        <div style="display:flex;justify-content:center;gap:10px;flex-wrap:wrap;"><span class="demo-badge-big b-blue" style="font-size:12px;padding:6px 14px;">🤖 AI / ML</span><span class="demo-badge-big" style="font-size:12px;padding:6px 14px;background:var(--amber-bg);color:var(--amber);">📍 Spatial Intelligence</span><span class="demo-badge-big" style="font-size:12px;padding:6px 14px;background:var(--green-bg);color:var(--green);">🛡️ Evidence</span><span class="demo-badge-big" style="font-size:12px;padding:6px 14px;background:var(--surface);color:var(--text2);">👷 Human Expertise</span></div>
      </div>
      <div style="text-align:center;margin-top:32px;">
        <p style="font-size:14px;color:var(--text2);margin-bottom:16px;">BuildMe does not replace professional engineering judgment.<br>AI assists. Engineers review. BuildMe records the evidence.</p>
        <button class="demo-btn demo-btn-p" onclick="closeDemo()" style="font-size:16px;padding:14px 28px;">Exit Demo → Explore BuildMe</button>
      </div>
    </div>

  </div><!-- /demo-body -->
</div><!-- /demo-overlay -->

<script>
let demoStep=1;const demoTotal=11;
function openDemo(){document.getElementById('demo-overlay').classList.add('show');demoStep=1;updateDemo();}
function closeDemo(){document.getElementById('demo-overlay').classList.remove('show');}
function demoNav(dir){demoStep=Math.max(1,Math.min(demoTotal,demoStep+dir));updateDemo();}
function updateDemo(){document.querySelectorAll('.demo-step').forEach(s=>s.classList.remove('active'));const s=document.querySelector('[data-step="'+demoStep+'"]');if(s)s.classList.add('active');document.getElementById('demo-step-label').textContent='Step '+demoStep+' / '+demoTotal;document.getElementById('demo-progress-fill').style.width=(demoStep/demoTotal*100)+'%';document.getElementById('demo-prev').style.display=demoStep===1?'none':'inline-flex';document.getElementById('demo-next').textContent=demoStep===demoTotal?'Finish':'Next →';document.getElementById('demo-next').onclick=demoStep===demoTotal?closeDemo:()=>demoNav(1);}
</script>
</body>
</html>
