# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Markdown documentation files
*.md

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Database (never commit — use Postgres in production)
prisma/dev.db
prisma/*.db

# User-uploaded files (ephemeral — use object storage in production)
public/uploads/

# Bulk export / import artifacts (dev only)
quotation_import_output/

# Screenshots and demo videos (large binary assets, keep out of git)
cedi_screenshots/
demo_videos/

# Python dev/capture/record scripts
scripts/*.py
*.py
*.csv
*.pdf
_archive/
.vercel-trigger
start-server.ps1
start.js

